# All values are configuration — nothing assumes a fixed host path or TTY.

# ── Required for a real Telegram run (you create these via @BotFather) ──────
TACP_BOT_TOKEN=
TACP_OPERATOR_USER_ID=

# Paths you choose (portable; no $HOME defaults baked into the binary)
TACP_STORE_PATH=./data/tacp-store.json
TACP_ACPX_STATE_DIR=./data/acpx-state
# Durable ACP session records: $TACP_ACPX_STATE_DIR/sessions/<sessionKey>.json
#
# Long-lived agent owner (Ursula-style). Prefer for restarts without killing agents:
#   Terminal 1: bun run acp-host
#   Terminal 2: TACP_ACP_HOST=1  (or auto if socket exists)
# TACP_ACP_HOST=1
# TACP_ACP_HOST_SOCK=./data/acpx-state/acp-host.sock
# Durable ACP session records: $TACP_ACPX_STATE_DIR/sessions/<sessionKey>.json

# Repo keys for /new picker (quote the JSON value)
# TACP_REPOS_JSON='{"demo":"/absolute/path/to/tacp/demo","tacp":"/absolute/path/to/tacp"}'

# real = ACP SDK host (spawns agent CLI over stdio)
# echo = no agent process; replies with an echo so you can prove Telegram works
TACP_AGENT_BACKEND=echo

# Built-ins: grok-build | codex | claude (alias: grok → grok-build)
# TACP_DEFAULT_AGENT=grok-build
# TACP_AGENT_COMMAND_JSON='{"grok-build":{"command":"grok","args":["agent","stdio"]}}'

# For grok-build without cached login:
# XAI_API_KEY=

# TACP_OPERATOR_CHAT_ID=

# Optional extra skill collection dirs (colon-separated). Defaults include
# ~/.grok/skills, ~/.grok/bundled/skills, ~/.agents/skills when HOME is set.
# TACP_SKILL_ROOTS=/path/to/skills:/other/skills

# Media / speech — TTS prefers ElevenLabs (same as Ursula/Kyoto)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EST9Ui6982FZPSi7gCHi
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# TACP_STT=1             # default on when a key is set; 0=off
# TACP_TTS_MODE=agent    # agent (default) | always | off
#                        # agent = only when model calls MCP speak or <<<speak>>>
#
# Host MCP tools (FastMCP stdio) injected into ACP sessions via mcpServers:
# TACP_MCP=1             # default on; 0=disable speak (and future STT tools)
#
# Remote MCP OAuth (acp-host serves GET /oauth/callback; tokens under acpx state):
# TACP_OAUTH_CALLBACK_BASE=https://your-host.ts.net
#   # or http://100.x.y.z:8788 — must be reachable from the phone browser
# TACP_OAUTH_LISTEN_HOST=0.0.0.0
# TACP_OAUTH_LISTEN_PORT=8788
# Per-gateway overrides when AS metadata is missing (ID uppercased, non-alnum → _):
# TACP_MCP_OAUTH_LINEAR_AUTH_URL=https://…
# TACP_MCP_OAUTH_LINEAR_TOKEN_URL=https://…
# TACP_MCP_OAUTH_LINEAR_CLIENT_ID=tacp
# TACP_MCP_OAUTH_LINEAR_SCOPE=
# TACP_MCP_OAUTH_CLIENT_ID=tacp
#
# Optional OpenAI Whisper STT fallback (and OpenAI TTS only if no ElevenLabs):
# OPENAI_API_KEY=sk-...
# TACP_OPENAI_BASE_URL=https://api.openai.com/v1
#
# ACP image/audio content blocks (off by default — grok-build does not advertise
# promptCapabilities.image; media is saved under .tacp-inbox/ instead):
# TACP_ACP_MEDIA_ATTACHMENTS=1

# Logging: debug | info | warn | error | silent
# TACP_LOG_LEVEL=debug
# TACP_VERBOSE=1   # same as debug
