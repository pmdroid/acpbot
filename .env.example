# All values are configuration — nothing assumes a fixed host path or TTY.

# ── Required for a real Telegram run (you create these via @BotFather) ──────
TACP_BOT_TOKEN=
TACP_OPERATOR_USER_ID=

# Paths you choose (portable; no $HOME defaults baked into the binary)
TACP_STORE_PATH=./data/tacp-store.json
# Prefer an **absolute** path. Worker + acp-host must share the same absolute
# TACP_STATE_DIR (OAuth pending PKCE, tokens, acp-host socket). Relative
# paths are resolved at process start (CWD-dependent if processes start elsewhere).
TACP_STATE_DIR=./data/tacp-state
# Durable ACP session records: $TACP_STATE_DIR/sessions/<sessionKey>.json
# OAuth tokens: $TACP_STATE_DIR/mcp-oauth/by-repo/<repoKey>/<id>.json (mode 0600)
# Keep this directory private (owner-only); default data/ is gitignored.
#
# Long-lived agent owner (required). Worker fails boot if host is not up:
#   Terminal 1: bun run acp-host
#   Terminal 2: bun run start
# TACP_ACP_HOST_SOCK=./data/tacp-state/acp-host.sock   # optional override

# Repo keys for /new picker + acp-host schedule scan (quote the JSON value)
# TACP_REPOS_JSON='{"tacp":"/absolute/path/to/tacp"}'
# Schedule ticker (acp-host): scan each repo's .tacp/schedules/ every N ms (default 20000)
# TACP_SCHEDULE_TICK_MS=20000

# Remote MCP OAuth callback (optional). When set, acp-host serves GET /oauth/callback.
# TACP_OAUTH_CALLBACK_BASE=https://your-host.ts.net

# Always real ACP agents. Optional overrides:
# TACP_CLAUDE_ACP_PKG=@agentclientprotocol/claude-agent-acp@0.64.0
# TACP_CODEX_ACP_PKG=@agentclientprotocol/codex-acp@1.1.7

# Built-ins: grok-build | claude | codex | opencode (aliases: grok, claude-code, …)
# TACP_DEFAULT_AGENT=grok-build
# TACP_AGENT_COMMAND_JSON='{"grok-build":{"command":"grok","args":["agent","stdio"]}}'

# TACP_OPERATOR_CHAT_ID=

# Optional extra skill collection dirs (colon-separated). Defaults include
# ~/.grok/skills, ~/.grok/bundled/skills, ~/.agents/skills when HOME is set.
# TACP_SKILL_ROOTS=/path/to/skills:/other/skills

# Media / speech — TTS prefers ElevenLabs (same as Ursula/Kyoto)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EST9Ui6982FZPSi7gCHi
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# TACP_STT=1             # default on when a key is set; 0=off
# TACP_TTS_MODE=agent    # agent (default) | always | off
#                        # agent = only when model calls MCP speak
#
# Host MCP tools (FastMCP stdio) injected into ACP sessions via mcpServers:
# TACP_MCP=1             # default on; 0=disable speak (and future STT tools)
#
# Remote MCP OAuth (acp-host serves GET /oauth/callback; tokens under state):
# TACP_OAUTH_CALLBACK_BASE=https://your-host.ts.net
#   # or http://100.x.y.z:8788 — must be reachable from the phone browser
#   # Prefer Tailscale Serve over public Funnel/IP. Default listen is 0.0.0.0 so
#   # redirects work; protection is high-entropy state + PKCE (code alone is useless).
#   # If bind fails, acp-host exits when this base is set — free the port or use
#   # /mcp code <full-callback-url> paste fallback.
# TACP_OAUTH_LISTEN_HOST=0.0.0.0
# TACP_OAUTH_LISTEN_PORT=8788
# Pending PKCE expires after 15 minutes.
# Endpoints + client_id are discovered from the MCP gateway (protected-resource
# metadata → AS metadata → dynamic client registration). No per-gateway OAuth
# AUTH_URL / CLIENT_ID env vars.
#
# Optional OpenAI Whisper STT fallback (and OpenAI TTS only if no ElevenLabs):
# OPENAI_API_KEY=sk-...
# TACP_OPENAI_BASE_URL=https://api.openai.com/v1
#
# ACP image/audio content blocks (off by default — grok-build does not advertise
# promptCapabilities.image; media is saved under .tacp-inbox/ instead):
# TACP_ACP_MEDIA_ATTACHMENTS=1

# Logging: debug | info | warn | error | silent
# TACP_LOG_LEVEL=debug
# TACP_VERBOSE=1   # same as debug
