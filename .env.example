# DEPRECATED for day-to-day use.
#
# Prefer a TOML config (launchd / binary install):
#   mkdir -p ~/.config/acpbot
#   cp config.example.toml ~/.config/acpbot/config.toml
#   chmod 600 ~/.config/acpbot/config.toml
#
# See docs/configuration.md and config.example.toml.
#
# Env vars remain optional overrides (CI / Docker).

# Path to TOML (optional if using ~/.config/acpbot/config.toml)
# ACPBOT_CONFIG=~/.config/acpbot/config.toml

# Overrides (only if not set in TOML):
# ACPBOT_BOT_TOKEN=
# ACPBOT_STORE_PATH=~/.local/share/acpbot/store.json
# ACPBOT_STATE_DIR=~/.local/share/acpbot/state
# ACPBOT_REPOS_JSON='{"demo":"/absolute/path"}'
# ACPBOT_DEFAULT_AGENT=grok-build
