{
  "name": "tacp-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run server/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4096",
    "dev:chat": "bun run server/chat-server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4096",
    "start": "bun run dev"
  },

  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.3"
  }
}
