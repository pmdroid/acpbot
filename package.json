{
  "name": "acpbot",
  "version": "0.1.0",
  "description": "acpbot — Telegram control surface for ACP coding agents (acpbot.app)",
  "type": "module",
  "module": "src/main.ts",
  "bin": {
    "acpbot": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts worker",
    "test": "bun test ./test",
    "test:contract": "bun test test/contract",
    "test:acp": "bun test test/contract/acp-capabilities.test.ts test/contract/acp-host-client-live.test.ts test/contract/acp-permission.test.ts test/session-mode.test.ts test/session-config.test.ts test/acp-live-agents.test.ts test/acp-host.test.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "acp-host": "bun run src/main.ts host",
    "worker": "bun run src/main.ts worker",
    "skills:install": "bun run src/main.ts skills install",
    "build:compile": "mkdir -p dist && bun build --compile --outfile=dist/acpbot src/main.ts",
    "build:compile:host": "mkdir -p dist && bun build --compile --outfile=dist/acpbot src/main.ts",
    "build:compile:worker": "mkdir -p dist && bun build --compile --outfile=dist/acpbot src/main.ts",
    "release:darwin": "bash scripts/release-darwin.sh",
    "docker:build": "docker build -t acpbot:local .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "website:dev": "cd website && bun run dev",
    "website:build": "cd website && bun install && bun run build",
    "website:preview": "cd website && bun run preview",
    "website:deploy": "npx wrangler pages deploy",
    "deploy": "npx wrangler pages deploy"
  },
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@clack/prompts": "^1.7.0",
    "@prefecthq/fastmcp-ts": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
