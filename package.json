{
  "name": "tacp",
  "version": "0.1.0",
  "description": "Telegram control surface for ACP coding agents",
  "type": "module",
  "module": "src/main.ts",
  "bin": {
    "tacp": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test ./test",
    "test:contract": "bun test test/contract",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "postinstall": "bun run --cwd forks/acpx build || true",
    "build:fork": "bun run --cwd forks/acpx build"
  },
  "license": "MIT",
  "dependencies": {
    "@prefecthq/fastmcp-ts": "^1.2.1",
    "acpx": "file:./forks/acpx",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
